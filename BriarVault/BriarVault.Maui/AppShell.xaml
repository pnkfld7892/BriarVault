<?xml version="1.0" encoding="UTF-8"?>

<Shell
    x:Class="BriarVault.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:local="clr-namespace:BriarVault.Maui"
    xmlns:pages="clr-namespace:BriarVault.Maui.Views"
    Title="BriarVault.Maui">
    <Shell.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{StaticResource Primary40}" StatusBarStyle="LightContent"></mct:StatusBarBehavior>
    </Shell.Behaviors>

    <TabBar>
        <Tab Title="Home">
            <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate pages:MainPage}"
                Route="MainPage" />
        </Tab>
        <Tab Title="Test">
        <ShellContent
            Title="Test"
            ContentTemplate="{DataTemplate pages:TestPage}"
            Route="TestPage" />
        </Tab>
    </TabBar>

</Shell>